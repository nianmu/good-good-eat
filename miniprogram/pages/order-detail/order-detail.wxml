<view class="page">
  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
    <block wx:if="{{order}}">
      <!-- 订单状态 + 步骤条 -->
      <view class="order-section">
        <view class="order-section__header">
          <text>订单状态</text>
          <status-chip status="{{order.status}}" />
        </view>
        <view class="order-stepper">
          <block wx:for="{{steps}}" wx:key="key">
            <view class="order-stepper__step {{item.cls}}">
              <view class="order-stepper__dot">{{item.dot}}</view>
              <text class="order-stepper__label">{{item.label}}</text>
            </view>
            <view wx:if="{{index < 4}}" class="order-stepper__line {{item.lineDone ? 'order-stepper__line--done' : ''}}"></view>
          </block>
        </view>
      </view>

      <!-- 取餐码主卡片 -->
      <view class="pickup-card">
        <view class="pickup-card__label">取 餐 码</view>
        <view class="pickup-card__code">{{order.pickup_code}}</view>
        <view class="pickup-card__hint">厨师做完凭码喊你 · 如「{{order.pickup_code}} 好了」</view>
      </view>

      <!-- 信息行 -->
      <view class="order-section">
        <view class="info-row">
          <text class="info-row__label">点餐团队</text>
          <text class="info-row__value">{{order.team_name || '—'}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">点餐人</text>
          <text class="info-row__value">{{order.user_avatar || '👤'}} {{order.user_nickname || '—'}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">下单时间</text>
          <text class="info-row__value">{{order.created_at || '—'}}</text>
        </view>
      </view>

      <!-- 菜品清单 -->
      <view class="order-section">
        <view class="order-section__header">
          <text>菜品清单</text>
          <text class="text-placeholder text-xs">共 {{order.items.length}} 种</text>
        </view>
        <view class="order-item" wx:for="{{order.items}}" wx:key="dish_id">
          <view class="order-item__image" style="background-color:{{item.color}}">{{item.emoji}}</view>
          <view class="order-item__body">
            <view class="order-item__name">{{item.name}}</view>
            <view class="order-item__meta">单价 ¥{{item.price_text}}</view>
          </view>
          <view class="order-item__right">
            <view class="order-item__qty">×{{item.quantity}}</view>
            <view class="order-item__total">¥{{item.total_text}}</view>
          </view>
        </view>
        <view class="order-summary">
          <text class="order-summary__count">共 {{order.total_count}} 道</text>
          <text class="order-summary__amount">¥{{order.total_amount_text}}</text>
        </view>
      </view>
    </block>
    <empty-state wx:if="{{!loading && !order}}" icon="📦" text="订单不存在或已删除">
      <view class="empty-btn" bindtap="goOrders">查看我的订单</view>
    </empty-state>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="order-actions" wx:if="{{order}}">
    <view wx:if="{{canClaim}}" class="order-actions__btn order-actions__btn--claim {{submitting ? 'order-actions__btn--disabled' : ''}}" bindtap="onClaim">👨‍🍳 认领做菜</view>
    <view class="order-actions__btn order-actions__btn--copy" bindtap="onCopy">📋 复制订单信息</view>
    <view class="order-actions__btn order-actions__btn--primary {{submitting ? 'order-actions__btn--disabled' : ''}}" bindtap="onPrimary">
      {{submitting ? '处理中…' : actionLabel}}
    </view>
  </view>
</view>