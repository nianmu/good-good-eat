.scroll-area {
  padding: 24rpx;
}

/* ===== 订单状态区 ===== */
.order-section {
  background: #FFFFFF;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.order-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--font-size-base);
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* ===== 状态步骤条 ===== */
.order-stepper {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0 8rpx;
}

.order-stepper__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.order-stepper__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  background: #E0E0E0;
  color: var(--color-text-placeholder);
}

.order-stepper__step--done .order-stepper__dot {
  background: var(--color-primary);
  color: #FFFFFF;
}

.order-stepper__step--current .order-stepper__dot {
  background: #FFFFFF;
  border: 4rpx solid var(--color-primary);
  color: var(--color-primary);
  box-shadow: 0 0 0 6rpx var(--color-primary-bg);
}

.order-stepper__label {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  white-space: nowrap;
}

.order-stepper__step--current .order-stepper__label {
  color: var(--color-primary);
  font-weight: 600;
}

.order-stepper__line {
  flex: 1;
  height: 4rpx;
  background: var(--color-divider);
  margin: 20rpx 8rpx 0;
  min-width: 16rpx;
}

.order-stepper__line--done {
  background: var(--color-primary);
}

/* ===== 取餐码卡片 ===== */
.pickup-card {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  color: #FFFFFF;
  text-align: center;
  box-shadow: var(--shadow-primary);
  margin-bottom: 24rpx;
}

.pickup-card__label {
  font-size: var(--font-size-sm);
  letter-spacing: 8rpx;
  opacity: 0.85;
}

.pickup-card__code {
  font-size: var(--font-size-display);
  font-weight: 700;
  letter-spacing: 16rpx;
  margin: 8rpx 0;
  text-indent: 16rpx;
}

.pickup-card__hint {
  font-size: var(--font-size-xs);
  opacity: 0.8;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: var(--font-size-sm);
}

.info-row__label {
  color: var(--color-text-secondary);
}

.info-row__value {
  color: var(--color-text-primary);
  font-weight: 500;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 菜品清单 ===== */
.order-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
}

.order-item + .order-item {
  border-top: 1px solid var(--color-divider);
}

.order-item__image {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.order-item__body {
  flex: 1;
  min-width: 0;
}

.order-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.order-item__meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin-top: 4rpx;
}

.order-item__right {
  text-align: right;
}

.order-item__qty {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.order-item__total {
  font-size: var(--font-size-base);
  font-weight: 600;
  margin-top: 4rpx;
}

.order-summary {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 1px dashed var(--color-divider);
}

.order-summary__count {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.order-summary__amount {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-danger);
}

/* ===== 底部操作栏 ===== */
.order-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.order-actions__btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: 9999rpx;
  font-size: var(--font-size-base);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.order-actions__btn:active {
  transform: scale(0.97);
}

.order-actions__btn--copy {
  background: #FFFFFF;
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
}

.order-actions__btn--primary {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}

.order-actions__btn--primary:active {
  background: var(--color-primary-dark);
}

.order-actions__btn--disabled {
  opacity: 0.6;
}
/* 认领做菜按钮（三期） */
.order-actions__btn--claim {
  background: #FFF3E0;
  color: var(--color-accent);
  border: 1px solid #FFE0B2;
}
.order-actions__btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}
