.add-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-sm);
}

.add-bar__name {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: var(--font-size-base);
}

.add-bar__qty {
  width: 180rpx;
  height: 64rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.add-bar__ph {
  color: var(--color-text-placeholder);
}

.add-bar__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-primary);
}

.add-bar__btn:active {
  background: var(--color-primary-dark);
  transform: scale(0.94);
}

.section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section__title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.section__count {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.basket-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.basket-item + .basket-item {
  border-top: 1px solid var(--color-divider);
}

.basket-item__check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  flex-shrink: 0;
  font-size: 28rpx;
}

.basket-item--checked .basket-item__check {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.basket-item__body {
  flex: 1;
  min-width: 0;
}

.basket-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.basket-item--checked .basket-item__name {
  color: var(--color-text-placeholder);
  text-decoration: line-through;
}

.basket-item__qty {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin-top: 4rpx;
}

.basket-item__del {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  background: #FDECEA;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
}
