<view class="page">
  <scroll-view class="scroll-area" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
    <!-- 添加待购 -->
    <view class="add-bar">
      <input class="add-bar__name" placeholder="待购物品（如：鸡蛋）" placeholder-class="add-bar__ph"
        value="{{addName}}" bindinput="onNameInput" />
      <input class="add-bar__qty" placeholder="数量（可选）" placeholder-class="add-bar__ph"
        value="{{addQuantity}}" bindinput="onQuantityInput" />
      <view class="add-bar__btn" bindtap="onAdd">＋</view>
    </view>

    <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

    <view class="section" wx:if="{{!loading}}">
      <view class="section__header">
        <text class="section__title">待采购</text>
        <text class="section__count">{{items.length}} 项 · {{checkedCount}} 已完成</text>
      </view>
      <block wx:if="{{items.length > 0}}">
        <view class="basket-item {{item.checked ? 'basket-item--checked' : ''}}"
          wx:for="{{items}}" wx:key="id"
          data-id="{{item.id}}" data-checked="{{item.checked}}" bindtap="onCheck">
          <view class="basket-item__check">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <view class="basket-item__body">
            <view class="basket-item__name">{{item.name}}</view>
            <view class="basket-item__qty">{{item.quantity || '—'}}</view>
          </view>
          <view class="basket-item__del" data-id="{{item.id}}" catchtap="onDelete">删除</view>
        </view>
      </block>
      <empty-state wx:else icon="🛒" text="菜篮空空，把要买的东西加进来吧" />
    </view>
  </scroll-view>
</view>
