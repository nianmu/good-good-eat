.hero {
  width: 100%;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__emoji {
  font-size: 160rpx;
}

.section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section__title {
  font-size: var(--font-size-md);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.recipe-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  margin-bottom: 16rpx;
}

.recipe-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.recipe-meta__item {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.recipe-meta__tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
}

.recipe-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.ingredient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ingredient-chip {
  padding: 10rpx 24rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  font-size: var(--font-size-sm);
  border-radius: 9999rpx;
}

.step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.step__num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step__text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
  padding-top: 6rpx;
}

.no-steps {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.action-bar__btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-size: var(--font-size-base);
  font-weight: 500;
}

.action-bar__btn--edit {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}

.action-bar__btn--delete {
  background: var(--color-primary-bg);
  color: var(--color-danger);
}
