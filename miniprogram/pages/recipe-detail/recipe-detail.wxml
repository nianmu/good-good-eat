<view class="page">
  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
    <block wx:if="{{recipe}}">
      <!-- 大图 -->
      <view class="hero" style="background-color:{{recipe.color}}">
        <text class="hero__emoji">{{recipe.emoji}}</text>
      </view>

      <view class="section">
        <view class="recipe-title">{{recipe.name}}</view>
        <view class="recipe-meta">
          <text class="recipe-meta__item">⏱ {{recipe.cook_time ? recipe.cook_time + ' 分钟' : '—'}}</text>
          <text class="recipe-meta__item" wx:if="{{recipe.difficulty}}">难度：{{recipe.difficulty}}</text>
          <text class="recipe-meta__tag" wx:if="{{recipe.is_public}}">公开</text>
        </view>
        <view class="recipe-desc">{{recipe.description || '暂无简介'}}</view>
      </view>

      <!-- 食材清单 -->
      <view class="section">
        <view class="section__title">食材清单</view>
        <view class="ingredient-list">
          <text wx:for="{{recipe.ingredients}}" wx:key="*this" class="ingredient-chip">{{item}}</text>
        </view>
      </view>

      <!-- 做法步骤 -->
      <view class="section">
        <view class="section__title">做法步骤</view>
        <block wx:if="{{recipe.steps.length > 0}}">
          <view class="step" wx:for="{{recipe.steps}}" wx:key="index">
            <view class="step__num">{{index + 1}}</view>
            <view class="step__text">{{item}}</view>
          </view>
        </block>
        <view wx:else class="no-steps">暂未填写做法步骤</view>
      </view>
    </block>
    <empty-state wx:if="{{!loading && !recipe}}" icon="🍽" text="菜谱不存在或已删除" />
  </scroll-view>

  <view class="action-bar" wx:if="{{recipe && isOwner}}">
    <view class="action-bar__btn action-bar__btn--edit" bindtap="onEdit">编辑</view>
    <view class="action-bar__btn action-bar__btn--delete" bindtap="onDelete">删除</view>
  </view>
</view>
