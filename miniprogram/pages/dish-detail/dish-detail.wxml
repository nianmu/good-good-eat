<view class="page">
  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
    <block wx:if="{{dish}}">
      <!-- 大图：emoji 色块 -->
      <view class="hero" style="background-color:{{dish.color}}">
        <text class="hero__emoji">{{dish.emoji}}</text>
      </view>

      <!-- 基本信息 -->
      <view class="section">
        <view class="dish-title">{{dish.name}}</view>
        <view class="dish-meta">
          <text class="dish-meta__rating">★ {{dish.rating}}<text class="dish-meta__sub">（{{dish.rating_count}} 人评）</text></text>
          <text class="dish-meta__item">⏱ {{dish.cook_time}}分钟</text>
          <text class="dish-meta__item">难度：{{dish.difficulty}}</text>
        </view>
        <view class="dish-desc">{{dish.description}}</view>
      </view>

      <!-- 食材清单 -->
      <view class="section">
        <view class="section__title">食材清单</view>
        <view class="ingredient-list">
          <text wx:for="{{dish.ingredients}}" wx:key="*this" class="ingredient-chip">{{item}}</text>
        </view>
      </view>

      <!-- 做法简述 -->
      <view class="section">
        <view class="section__title">做法简述</view>
        <view class="cook-note">
          精选 {{dish.name}}，以「{{ingredientsText}}」为主料，
          火候到位、调味均衡，家常味十足。完整菜谱（图文步骤）将在第四期「厨房菜谱」开放，敬请期待。
        </view>
      </view>
    </block>
    <empty-state wx:if="{{!loading && !dish}}" icon="🍽" text="菜品不存在或已下架" />
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="detail-bar" wx:if="{{dish}}">
    <view class="detail-bar__price">
      <text class="detail-bar__price-symbol">¥</text>
      <text class="detail-bar__price-num">{{priceText}}</text>
    </view>
    <qty-stepper value="{{qty}}" min="{{1}}" bind:change="onQtyChange" />
    <view class="detail-bar__add" bindtap="onAddToCart">加入购物车</view>
  </view>
</view>