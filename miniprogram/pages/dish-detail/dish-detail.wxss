/* 大图 emoji 色块 */
.hero {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__emoji {
  font-size: 180rpx;
}

/* 通用区块 */
.section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section__title {
  font-size: var(--font-size-md);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.dish-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  margin-bottom: 16rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.dish-meta__rating {
  font-size: var(--font-size-sm);
  color: var(--color-accent);
  font-weight: 600;
}

.dish-meta__sub {
  color: var(--color-text-placeholder);
  font-weight: 400;
}

.dish-meta__item {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.dish-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 食材标签 */
.ingredient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ingredient-chip {
  padding: 10rpx 24rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  font-size: var(--font-size-sm);
  border-radius: 9999rpx;
}

/* 做法简述 */
.cook-note {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* 底部操作栏 */
.detail-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.detail-bar__price {
  flex: 1;
  color: var(--color-danger);
}

.detail-bar__price-symbol {
  font-size: var(--font-size-sm);
}

.detail-bar__price-num {
  font-size: var(--font-size-xxl);
  font-weight: 700;
}

.detail-bar__add {
  padding: 24rpx 56rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-size-md);
  font-weight: 500;
  border-radius: 9999rpx;
  box-shadow: var(--shadow-primary);
}

.detail-bar__add:active {
  background: var(--color-primary-dark);
  transform: scale(0.97);
}