<view class="page">
  <scroll-view class="scroll-area" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
    <!-- 顶部绿色主题区 -->
    <view class="profile-header">
      <view class="profile-header__slogan">一日三餐，用好大一颗菜</view>
      <view class="user-card">
        <view class="user-card__avatar">{{user.avatar}}</view>
        <view class="user-card__info">
          <view class="user-card__name">{{user.nickname}}</view>
          <view class="user-card__code">标识码 {{user.code || '—'}}</view>
        </view>
        <view class="user-card__qr">⋮</view>
      </view>
      <view class="user-stats">
        <view class="user-stats__item">
          <view class="user-stats__num">{{stats.totalOrders}}</view>
          <view class="user-stats__label">总订单</view>
        </view>
        <view class="user-stats__divider"></view>
        <view class="user-stats__item">
          <view class="user-stats__num">{{stats.totalDishes}}</view>
          <view class="user-stats__label">点过的菜</view>
        </view>
        <view class="user-stats__divider"></view>
        <view class="user-stats__item">
          <view class="user-stats__num">{{stats.favoriteDishes}}</view>
          <view class="user-stats__label">收藏</view>
        </view>
      </view>
    </view>

    <!-- 我的团队 -->
    <view class="section">
      <view class="section__header">
        <text class="section__title">我的团队</text>
        <text class="section__more" bindtap="onManageTeams">管理 ›</text>
      </view>
      <block wx:if="{{teams.length > 0}}">
        <view class="team-item" wx:for="{{teams}}" wx:key="id" data-id="{{item.id}}" bindtap="onTeamTap">
          <view class="team-item__avatar">{{item.icon}}</view>
          <view class="team-item__body">
            <view class="team-item__name">
              <text>{{item.name}}</text>
              <text class="team-item__role">{{item.role_label}}</text>
            </view>
            <view class="team-item__meta">
              {{item.member_count}} 位成员 ·
              <text class="{{item.chef ? 'team-item__chef' : 'team-item__chef--open'}}">
                {{item.chef ? '厨师：' + item.chef : '厨师待认领'}}
              </text>
            </view>
          </view>
          <text class="team-item__arrow">›</text>
        </view>
      </block>
      <empty-state wx:else icon="🏠" text="还没有加入团队，去创建一个吧">
        <view class="empty-btn" bindtap="onManageTeams">去创建/加入</view>
      </empty-state>
    </view>

    <!-- 功能宫格 -->
    <view class="section">
      <view class="section__header">
        <text class="section__title">我的厨房</text>
      </view>
      <view class="feature-grid">
        <view class="feature-item" wx:for="{{features}}" wx:key="id" data-name="{{item.name}}" bindtap="onFeatureTap">
          <view class="feature-item__icon" style="background-color:{{item.bgColor}};color:{{item.color}}">{{item.icon}}</view>
          <text class="feature-item__name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 底部声明 -->
    <view class="disclaimer">
      <text class="disclaimer__text">本平台面向家庭、情侣等用户，是美食记录与烹饪工具，不涉及订单支付，也不是商家收款工具。</text>
      <text class="disclaimer__warn">⚠ 如需转账，请自行核实对方身份，切勿轻信网络陌生人。</text>
    </view>
  </scroll-view>
</view>