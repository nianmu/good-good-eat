<view class="page">
  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 团队选择 -->
    <view class="team-card" wx:if="{{items.length > 0}}">
      <text class="team-card__label">下单团队</text>
      <picker range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="onTeamChange">
        <view class="team-card__picker">
          <text class="team-card__name">{{teams[teamIndex].name || '选择团队'}}</text>
          <text class="team-card__arrow">▾</text>
        </view>
      </picker>
      <view class="team-card__hint" wx:if="{{teamCartSummary}}">{{teamCartSummary}}</view>
    </view>

    <!-- 购物车列表 -->
    <view class="cart-list" wx:if="{{items.length > 0}}">
      <view class="cart-item" wx:for="{{items}}" wx:key="dish_id">
        <view class="cart-item__image" style="background-color:{{item.color}}">{{item.emoji}}</view>
        <view class="cart-item__body">
          <view class="cart-item__name">{{item.name}}</view>
          <view class="cart-item__price">¥{{item.price_text}}</view>
        </view>
        <view class="cart-item__right">
          <qty-stepper value="{{item.quantity}}" data-id="{{item.dish_id}}" bind:change="onQtyChange" />
          <view class="cart-item__remove" catchtap="onRemove" data-id="{{item.dish_id}}">删除</view>
        </view>
      </view>
    </view>

    <empty-state wx:elif="{{!loading}}" icon="🛒" text="购物车空空如也，去菜谱页挑几道菜吧">
      <view class="empty-btn" bindtap="goMenu">去点菜</view>
    </empty-state>
  </scroll-view>

  <!-- 底部结算栏 -->
  <view class="cart-bar" wx:if="{{items.length > 0}}">
    <view class="cart-bar__total">
      <text class="cart-bar__total-label">合计</text>
      <text class="cart-bar__total-amount">¥{{totalText}}</text>
    </view>
    <view class="cart-bar__count">共 {{totalCount}} 道</view>
    <view class="cart-bar__submit {{submitting ? 'cart-bar__submit--disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交下单'}}
    </view>
  </view>
</view>