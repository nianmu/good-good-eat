<view class="page">
  <view class="list">
    <view class="list-header">
      <text class="list-header__title">我的饮食计划</text>
      <text class="list-header__count" wx:if="{{total > 0}}">共 {{total}} 份</text>
    </view>

    <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

    <block wx:if="{{!loading && list.length > 0}}">
      <view class="plan-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onPlanTap">
        <view class="plan-card__top">
          <view class="plan-card__name">{{item.name}}</view>
          <view class="plan-card__count" wx:if="{{item.total_count}}">共 {{item.total_count}} 份</view>
        </view>
        <view class="plan-card__note" wx:if="{{item.note}}">{{item.note}}</view>
        <view class="plan-card__summary" wx:if="{{item.summary.length > 0}}">
          <text class="plan-card__dish" wx:for="{{item.summary}}" wx:key="dish_id">
            {{item.emoji || ''}} {{item.name}}<text wx:if="{{item.quantity > 1}}">×{{item.quantity}}</text>
          </text>
        </view>
        <view class="plan-card__arrow">›</view>
      </view>
      <view class="loading-tip" wx:if="{{loadingMore}}">加载中…</view>
    </block>

    <empty-state wx:if="{{!loading && list.length === 0}}" icon="📅"
      text="还没有饮食计划，创建一份吧">
      <view class="empty-btn" bindtap="onCreate">新建计划</view>
    </empty-state>
  </view>

  <view class="fab" bindtap="onCreate">
    <text class="fab__icon">＋</text>
  </view>
</view>
