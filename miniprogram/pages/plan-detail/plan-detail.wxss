.detail-header {
  padding: 32rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: #FFFFFF;
}

.detail-header__name {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.detail-header__meta {
  font-size: var(--font-size-sm);
  opacity: 0.9;
  margin-top: 8rpx;
}

.detail-header__note {
  font-size: var(--font-size-sm);
  opacity: 0.8;
  margin-top: 8rpx;
}

.list {
  padding: 24rpx;
}

.list-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.dish-item__emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.dish-item__emoji--empty {
  background: var(--color-bg-page);
}

.dish-item__body {
  flex: 1;
  min-width: 0;
}

.dish-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.dish-item__price {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.dish-item__qty {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.action-bar__delete {
  flex: 1;
  color: var(--color-danger);
  border-color: var(--color-border);
}

.action-bar__add {
  flex: 2;
}
