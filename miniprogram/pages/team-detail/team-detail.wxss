.scroll-area {
  padding: 24rpx;
}

/* 团队信息面板 */
.panel {
  background: #FFFFFF;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.panel__head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.panel__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-base);
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.panel__info {
  flex: 1;
  min-width: 0;
}

.panel__name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.panel__role {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 2rpx 16rpx;
  border-radius: 9999rpx;
  font-weight: 400;
}

.panel__meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
}

/* 邀请码 */
.invite-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1px solid var(--color-divider);
}

.invite-row__label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.invite-row__code {
  flex: 1;
  font-size: var(--font-size-md);
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-primary-dark);
}

.invite-row__copy {
  padding: 8rpx 24rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  border-radius: 9999rpx;
}

/* 厨师 */
.chef-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1px solid var(--color-divider);
}

.chef-row__label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.chef-row__value {
  flex: 1;
  font-size: var(--font-size-sm);
}

.chef-row__open {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-accent);
}

.chef-row__btn {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

/* 成员列表 */
.member-section {
  background: #FFFFFF;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.member-section__title {
  font-size: var(--font-size-md);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid var(--color-divider);
}

.member-item:last-child {
  border-bottom: none;
}

.member-item__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.member-item__name {
  font-size: var(--font-size-base);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-item__role {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  background: var(--color-bg-page);
  padding: 2rpx 16rpx;
  border-radius: 9999rpx;
}