<view class="page">
  <scroll-view class="scroll-area" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
    <block wx:if="{{team}}">
      <!-- 团队信息 -->
      <view class="panel">
        <view class="panel__head">
          <view class="panel__icon">{{team.icon || '🏠'}}</view>
          <view class="panel__info">
            <view class="panel__name">
              <text>{{team.name}}</text>
              <text class="panel__role">{{team.role === 'organizer' ? '我是组织者' : '我是成员'}}</text>
            </view>
            <view class="panel__meta">{{team.member_count}} 位成员</view>
          </view>
        </view>
        <view class="invite-row">
          <text class="invite-row__label">邀请码</text>
          <text class="invite-row__code">{{team.invite_code || '—'}}</text>
          <view class="invite-row__copy" bindtap="onCopyInvite">复制</view>
        </view>
        <view class="chef-row">
          <text class="chef-row__label">固定厨师</text>
          <text class="{{team.chef ? 'chef-row__value' : 'chef-row__open'}}">
            {{team.chef ? '👨‍🍳 ' + team.chef : '厨师待认领'}}
          </text>
          <view wx:if="{{team.role === 'organizer'}}" class="chef-row__btn" bindtap="onAssignChef">指定厨师 ›</view>
        </view>
      </view>

      <!-- 成员列表 -->
      <view class="member-section">
        <view class="member-section__title">成员列表（{{members.length}}）</view>
        <block wx:if="{{members.length > 0}}">
          <view class="member-item" wx:for="{{members}}" wx:key="id">
            <view class="member-item__avatar">{{item.avatar}}</view>
            <view class="member-item__name">
              <text>{{item.nickname}}</text>
              <text class="member-item__role">{{item.role_label}}</text>
            </view>
          </view>
        </block>
        <empty-state wx:else icon="👥" text="暂无成员" />
      </view>
    </block>
    <empty-state wx:if="{{!loading && !team}}" icon="👥" text="团队不存在或无权查看" />
  </scroll-view>
</view>