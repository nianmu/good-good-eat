/* ===== 顶部用户区 ===== */
.menu-header {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  padding: 32rpx 32rpx 48rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.menu-header__user {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.menu-header__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.menu-header__info {
  flex: 1;
  min-width: 0;
}

.menu-header__name {
  font-size: var(--font-size-md);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.menu-header__slogan {
  font-size: var(--font-size-xs);
  line-height: 1.5;
  opacity: 0.9;
}

.menu-header__team {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 9999rpx;
  font-size: var(--font-size-sm);
}

.menu-header__team-icon {
  font-size: 28rpx;
}

.menu-header__team-name {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-header__team-arrow {
  font-size: 20rpx;
  opacity: 0.8;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  border-bottom: 1px solid var(--color-divider);
}

.search-bar__input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page);
  border-radius: 9999rpx;
}

.search-bar__icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-bar__field {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  height: 100%;
}

.search-bar__placeholder {
  color: var(--color-text-placeholder);
}

.search-bar__cart-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 500;
  padding: 8rpx;
}

/* ===== 主体布局 ===== */
.menu-body {
  flex: 1;
  min-height: 0;
  display: flex;
}

/* 左侧分类 */
.category-sidebar {
  width: 176rpx;
  background: var(--color-bg-page);
  flex-shrink: 0;
  height: 100%;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  position: relative;
  min-height: 128rpx;
  justify-content: center;
  transition: background 150ms ease-out;
}

.category-item--active {
  background: #FFFFFF;
}

.category-item--active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: var(--color-primary);
  border-radius: 0 4rpx 4rpx 0;
}

.category-item__icon {
  font-size: 40rpx;
}

.category-item__name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.2;
  padding: 0 8rpx;
}

.category-item--active .category-item__name {
  color: var(--color-primary);
  font-weight: 600;
}

.category-item__count {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
}

/* 右侧菜品列表 */
.dish-list {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 24rpx;
  background: #FFFFFF;
}

.dish-list__category-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.action-bar__btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.action-bar__btn:active {
  transform: scale(0.97);
}

.action-bar__btn-icon {
  font-size: 36rpx;
}

.action-bar__btn--random {
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
}

.action-bar__btn--invite {
  background: #FFF3E0;
  color: var(--color-accent);
}

.action-bar__btn--submit {
  flex: 1.5;
  background: var(--color-primary);
  color: #FFFFFF;
  flex-direction: row;
  gap: 16rpx;
  box-shadow: var(--shadow-primary);
}

.action-bar__btn-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 9999rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 团队房间连接状态点（三期多人实时） */
.room-dot {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
  flex-shrink: 0;
}
.room-dot--connected { background: #C8E6C9; color: #1B5E20; }
.room-dot--reconnecting { background: #FFE0B2; color: #E65100; }
.room-dot--connecting { background: #FFF9C4; color: #F57F17; }
.room-dot--closed { background: rgba(255,255,255,0.25); color: #FFFFFF; }

/* ===== 五期：快捷区 ===== */
.quick-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.quick-row__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
}

.quick-row__item:active {
  transform: scale(0.97);
}

.quick-row__item--today {
  background: #FFF3E0;
  color: var(--color-accent);
}

.quick-row__item--surprise {
  background: #E3F2FD;
  color: #1565C0;
}

.quick-row__icon {
  font-size: 32rpx;
}

.quick-row__label {
  font-size: var(--font-size-sm);
  font-weight: 500;
}

/* ===== 五期：今天吃什么 弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.recommend-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
}

.recommend-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recommend-sheet__title {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.recommend-sheet__close {
  font-size: 36rpx;
  color: var(--color-text-placeholder);
  padding: 8rpx;
}

.recommend-sheet__people {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.recommend-sheet__input {
  width: 120rpx;
  height: 64rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: var(--font-size-base);
}

.recommend-sheet__go {
  margin-left: auto;
  min-height: 64rpx;
  padding: 0 32rpx;
  font-size: var(--font-size-sm);
}

.recommend-sheet__reason {
  font-size: var(--font-size-sm);
  color: var(--color-accent);
  font-weight: 600;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #FFF8E1;
  border-radius: var(--radius-sm);
}

.recommend-sheet__list {
  margin-bottom: 24rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 8rpx;
}

.recommend-item__emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.recommend-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommend-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.recommend-item__price {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  font-weight: 600;
}

.recommend-sheet__actions {
  display: flex;
  gap: 16rpx;
}

.recommend-sheet__actions .btn {
  flex: 1;
}
