<view class="page">
  <!-- 顶部用户区 + 团队 -->
  <view class="menu-header">
    <view class="menu-header__user">
      <view class="menu-header__avatar">{{user.avatar}}</view>
      <view class="menu-header__info">
        <view class="menu-header__name">{{user.nickname || '好大一颗菜'}}</view>
        <view class="menu-header__slogan">一粥一饭皆是生活，一蔬一菜皆有温度。</view>
      </view>
    </view>
    <view class="menu-header__team" bindtap="onTeamTap">
      <text class="menu-header__team-icon">🏠</text>
      <text class="menu-header__team-name">{{currentTeamName || '选择团队'}}</text>
      <text class="menu-header__team-arrow">▾</text>
      <text class="room-dot room-dot--{{roomStatus}}" wx:if="{{currentTeamId}}">{{roomStatusLabel}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-bar__input">
      <text class="search-bar__icon">🔍</text>
      <input class="search-bar__field" placeholder="搜索菜品或食材" placeholder-class="search-bar__placeholder"
        value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
    </view>
    <view class="search-bar__cart-badge" bindtap="onCartTap">
      <text>点单</text>
      <text class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
  </view>

  <!-- 主体：左侧分类 + 右侧菜品 -->
  <view class="menu-body">
    <scroll-view class="category-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{categories}}" wx:key="id"
        class="category-item {{item.id === activeCategoryId ? 'category-item--active' : ''}}"
        data-id="{{item.id}}" bindtap="onCategoryTap">
        <text class="category-item__icon">{{item.icon}}</text>
        <text class="category-item__name">{{item.name}}</text>
        <text class="category-item__count">{{item.count}}</text>
      </view>
    </scroll-view>

    <scroll-view class="dish-list" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
      <view class="dish-list__category-title">{{dishesTitle}}</view>
      <view class="loading-tip" wx:if="{{loading}}">加载中…</view>
      <block wx:if="{{!loading && dishes.length > 0}}">
        <dish-card wx:for="{{dishes}}" wx:key="id"
          dish="{{item}}" quantity="{{cart[item.id] || 0}}"
          joined-count="{{joinedCount[item.id] || 0}}"
          favorited="{{favoritedMap[item.id] || false}}"
          bind:tap="onDishTap" bind:qtychange="onQtyChange" bind:favorite="onFavorite" />
      </block>
      <empty-state wx:if="{{!loading && dishes.length === 0}}" icon="🍽" text="没有找到相关菜品" />
    </scroll-view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-bar__btn action-bar__btn--random" bindtap="onRandom">
      <text class="action-bar__btn-icon">🎲</text>
      <text class="action-bar__btn-text">随机点菜</text>
    </view>
    <view class="action-bar__btn action-bar__btn--invite" bindtap="onInvite">
      <text class="action-bar__btn-icon">📨</text>
      <text class="action-bar__btn-text">邀请下单</text>
    </view>
    <view class="action-bar__btn action-bar__btn--submit" bindtap="onSubmit">
      <text class="action-bar__btn-text">下单</text>
      <text class="action-bar__btn-count" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
  </view>
</view>