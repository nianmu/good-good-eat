<view class="page">
  <!-- 顶部状态筛选（横向滚动标签） -->
  <scroll-view class="filter-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-tabs">
      <view wx:for="{{statusTabs}}" wx:key="key"
        class="filter-tab {{status === item.key ? 'filter-tab--active' : ''}}"
        data-key="{{item.key}}" bindtap="onStatusTap">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 角色切换入口 -->
  <view class="role-switch" bindtap="onRoleTap">
    <text class="role-switch__title">{{roleMode === 'mine' ? '我的订单' : '厨师看板'}}</text>
    <text class="role-switch__hint">切换角色 ›</text>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="orders-scroll" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" lower-threshold="80"
    enhanced show-scrollbar="{{false}}">
    <block wx:if="{{orders.length > 0}}">
      <view class="order-card" wx:for="{{orders}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onOrderTap">
        <view class="order-card__head">
          <view class="order-card__left">
            <status-chip status="{{item.status}}" />
            <text class="order-card__team">{{item.team_name}}</text>
          </view>
          <view class="order-card__code">取餐码 {{item.pickup_code}}</view>
        </view>
        <view class="order-card__summary">{{item.summary}}</view>
        <view class="order-card__foot">
          <text class="order-card__time">{{item.time_text}}</text>
          <text class="order-card__amount">¥{{item.amount_text}}</text>
        </view>
      </view>

      <view class="load-tip">
        <text wx:if="{{loadingMore}}">加载中…</text>
        <text wx:elif="{{!hasMore}}">—— 没有更多订单了 ——</text>
        <text wx:else>上拉加载更多</text>
      </view>
    </block>
    <empty-state wx:elif="{{!loading}}" icon="📦" text="暂无订单，去菜谱页点几道菜吧">
      <view class="empty-btn" bindtap="goMenu">去点菜</view>
    </empty-state>
  </scroll-view>
</view>