.section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input {
  height: 88rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: var(--font-size-base);
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: var(--font-size-base);
  box-sizing: border-box;
}

.form-textarea--tall {
  min-height: 220rpx;
}

.form-placeholder {
  color: var(--color-text-placeholder);
}

/* emoji 选择器 */
.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.emoji-option {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border: 2px solid transparent;
}

.emoji-option--active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

/* 颜色选择器 */
.color-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-option {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx var(--color-border);
}

.color-option--active {
  box-shadow: 0 0 0 4rpx var(--color-primary);
}

/* 难度选择器 */
.difficulty-picker {
  display: flex;
  gap: 16rpx;
}

.difficulty-option {
  padding: 12rpx 32rpx;
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  border-radius: 9999rpx;
  font-size: var(--font-size-sm);
  border: 2rpx solid transparent;
}

.difficulty-option--active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-color: var(--color-primary);
}

/* 底部保存栏 */
.save-bar {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.save-bar__btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-size-base);
  font-weight: 500;
  border-radius: 9999rpx;
  box-shadow: var(--shadow-primary);
}

.save-bar__btn:active {
  background: var(--color-primary-dark);
  transform: scale(0.98);
}

.save-bar__btn--disabled {
  opacity: 0.6;
  pointer-events: none;
}
