.plan-edit .section {
  padding: 24rpx;
}

.section__title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.form-card {
  padding: 8rpx 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--color-divider);
}

.form-row:last-child {
  border-bottom: none;
}

.form-row__label {
  width: 96rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-row__input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.recommend-tip {
  margin-top: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-accent);
  padding: 16rpx;
  background: #FFF8E1;
  border-radius: var(--radius-sm);
}

/* 已选清单 */
.selected-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid var(--color-divider);
}

.selected-item:last-child {
  border-bottom: none;
}

.selected-item__emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.selected-item__body {
  flex: 1;
  min-width: 0;
}

.selected-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.selected-item__price {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.qty-op {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-op__btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.qty-op__num {
  min-width: 40rpx;
  text-align: center;
  font-size: var(--font-size-base);
  font-weight: 600;
}

/* 分类 tab */
.cat-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border-radius: var(--radius-full);
}

.cat-tab--active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 500;
}

/* 菜品选择 */
.dish-pick {
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-sm);
  padding: 8rpx 24rpx;
}

.dish-pick__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid var(--color-divider);
}

.dish-pick__item:last-child {
  border-bottom: none;
}

.dish-pick__emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.dish-pick__body {
  flex: 1;
  min-width: 0;
}

.dish-pick__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.dish-pick__price {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.dish-pick__add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 底部保存栏 */
.save-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--color-divider);
  flex-shrink: 0;
}

.save-bar__count {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.save-bar__btn {
  min-width: 260rpx;
}
