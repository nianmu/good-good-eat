<view class="page">
  <view class="msg-header" wx:if="{{total > 0}}">
    <text class="msg-header__count">共 {{total}} 条</text>
    <text class="msg-header__unread" wx:if="{{unreadCount > 0}}">{{unreadCount}} 条未读</text>
  </view>

  <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}"
    bindscrolltolower="onLoadMore">
    <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

    <block wx:if="{{!loading && messages.length > 0}}">
      <view class="msg-card {{item.is_read ? 'msg-card--read' : ''}}"
        wx:for="{{messages}}" wx:key="id" data-id="{{item.id}}" bindtap="onMessageTap">
        <view class="msg-card__dot" wx:if="{{!item.is_read}}"></view>
        <view class="msg-card__body">
          <view class="msg-card__title">{{item.title}}</view>
          <view class="msg-card__content">{{item.content}}</view>
          <view class="msg-card__time">{{item.time_text}}</view>
        </view>
      </view>
      <view class="loading-tip" wx:if="{{loadingMore}}">加载更多…</view>
    </block>

    <empty-state wx:if="{{!loading && messages.length === 0}}" icon="💬" text="暂无消息">
      <view class="sub-tip">订单状态、团队动态会在此通知你</view>
      <view class="empty-btn" bindtap="goMenu">去点菜</view>
    </empty-state>
  </scroll-view>
</view>