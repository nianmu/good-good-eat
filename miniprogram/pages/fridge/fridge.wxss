.add-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-sm);
}

.add-bar__name {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: var(--font-size-base);
}

.add-bar__qty {
  width: 180rpx;
  height: 64rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.add-bar__ph {
  color: var(--color-text-placeholder);
}

.add-bar__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-primary);
}

.add-bar__btn:active {
  background: var(--color-primary-dark);
  transform: scale(0.94);
}

.section {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section__title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.section__count,
.section__hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.fridge-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.fridge-item + .fridge-item {
  border-top: 1px solid var(--color-divider);
}

.fridge-item__emoji {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  background: var(--color-primary-bg);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fridge-item__body {
  flex: 1;
  min-width: 0;
}

.fridge-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
}

.fridge-item__qty {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin-top: 4rpx;
}

.fridge-item__del {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  background: #FDECEA;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
}

/* 推荐项 */
.suggest-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.suggest-item + .suggest-item {
  border-top: 1px solid var(--color-divider);
}

.suggest-item:active {
  opacity: 0.8;
}

.suggest-item__thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.suggest-item__body {
  flex: 1;
  min-width: 0;
}

.suggest-item__name {
  font-size: var(--font-size-base);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.suggest-item__tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
}

.suggest-item__tag--recipe {
  color: var(--color-accent);
  background: #FFF3E0;
}

.suggest-item__tag--dish {
  color: var(--color-primary);
  background: var(--color-primary-bg);
}

.suggest-item__meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggest-item__arrow {
  color: var(--color-text-placeholder);
  font-size: 32rpx;
}
