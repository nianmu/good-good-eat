<view class="page">
  <scroll-view class="scroll-area" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
    <!-- 添加食材 -->
    <view class="add-bar">
      <input class="add-bar__name" placeholder="食材名称（如：五花肉）" placeholder-class="add-bar__ph"
        value="{{addName}}" bindinput="onNameInput" />
      <input class="add-bar__qty" placeholder="数量（可选）" placeholder-class="add-bar__ph"
        value="{{addQuantity}}" bindinput="onQuantityInput" />
      <view class="add-bar__btn" bindtap="onAdd">＋</view>
    </view>

    <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

    <!-- 冰箱食材 -->
    <block wx:if="{{!loading}}">
      <view class="section">
        <view class="section__header">
          <text class="section__title">我的冰箱</text>
          <text class="section__count">{{items.length}} 种</text>
        </view>
        <block wx:if="{{items.length > 0}}">
          <view class="fridge-item" wx:for="{{items}}" wx:key="id">
            <view class="fridge-item__emoji">🧊</view>
            <view class="fridge-item__body">
              <view class="fridge-item__name">{{item.name}}</view>
              <view class="fridge-item__qty">{{item.quantity || '—'}}</view>
            </view>
            <view class="fridge-item__del" data-id="{{item.id}}" catchtap="onDelete">删除</view>
          </view>
        </block>
        <empty-state wx:else icon="🧊" text="冰箱还是空的，添加点食材吧" />
      </view>

      <!-- 冰箱能做的菜 -->
      <view class="section">
        <view class="section__header">
          <text class="section__title">冰箱能做的菜</text>
          <text class="section__hint">命中 2 种以上食材</text>
        </view>
        <block wx:if="{{suggest.length > 0}}">
          <view class="suggest-item" wx:for="{{suggest}}" wx:key="source+id"
            data-item="{{item}}" bindtap="onSuggestTap">
            <view class="suggest-item__thumb" style="background-color:{{item.color}}">{{item.emoji}}</view>
            <view class="suggest-item__body">
              <view class="suggest-item__name">
                {{item.name}}
                <text class="suggest-item__tag suggest-item__tag--{{item.source}}">
                  {{item.source === 'recipe' ? '我的菜谱' : '平台菜品'}}
                </text>
              </view>
              <view class="suggest-item__meta">
                命中 {{item.matched.length}}/{{item.total}} · {{item.matched.join('、')}}
              </view>
            </view>
            <text class="suggest-item__arrow">›</text>
          </view>
        </block>
        <empty-state wx:else icon="🍳" text="冰箱食材还凑不齐一道菜，多囤点吧" />
      </view>
    </block>
  </scroll-view>
</view>
