.page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.scroll-area {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-tip {
  text-align: center;
  padding: 48rpx 0;
  color: var(--color-text-placeholder);
  font-size: var(--font-size-sm);
}

/* 聚合卡 */
.agg-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}

.agg-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.agg-card__title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.agg-card__count {
  font-size: var(--font-size-sm);
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.agg-block {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.12);
  border-radius: var(--radius-md);
  padding: 16rpx;
}

.agg-block__title {
  font-size: 22rpx;
  opacity: 0.85;
  margin-bottom: 10rpx;
}

.agg-dish {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
  font-size: var(--font-size-sm);
}

.agg-dish__qty {
  margin-left: auto;
  font-weight: 700;
}

.agg-ing {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.agg-ing__chip {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 订单列表 */
.list-title {
  margin: 28rpx 4rpx 16rpx;
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

.order-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.order-card__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-card__code {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-primary-dark);
}

.order-card__time {
  margin-left: auto;
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.order-card__summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 14rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.order-card__user {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.order-card__row--end {
  justify-content: flex-end;
}

.order-card__action {
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-size-sm);
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
}

.order-card__action:active {
  transform: scale(0.96);
}

.order-card__done {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}