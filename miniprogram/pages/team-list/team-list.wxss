.scroll-area {
  padding: 24rpx;
}

/* 创建/加入面板 */
.panel {
  background: #FFFFFF;
  border-radius: var(--radius-base);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.panel__title {
  font-size: var(--font-size-base);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.panel__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.panel__input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
}

.panel__placeholder {
  color: var(--color-text-placeholder);
}

.panel__btn {
  padding: 20rpx 40rpx;
  background: #FFFFFF;
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  border-radius: 9999rpx;
  flex-shrink: 0;
}

.panel__btn--primary {
  background: var(--color-primary);
  color: #FFFFFF;
  border: none;
  box-shadow: var(--shadow-primary);
}

.panel__btn--disabled {
  opacity: 0.6;
}

.panel__btn:active {
  transform: scale(0.97);
}

/* 列表标题 */
.list-title {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding: 8rpx 8rpx 16rpx;
}

/* 团队卡片 */
.team-card {
  background: #FFFFFF;
  border-radius: var(--radius-base);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.team-card:active {
  opacity: 0.85;
}

.team-card__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.team-card__body {
  flex: 1;
  min-width: 0;
}

.team-card__name {
  font-size: var(--font-size-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.team-card__role {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 2rpx 16rpx;
  border-radius: 9999rpx;
  font-weight: 400;
}

.team-card__meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  line-height: 1.7;
}

.team-card__arrow {
  color: var(--color-text-placeholder);
  font-size: 36rpx;
}