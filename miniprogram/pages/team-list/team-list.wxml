<view class="page">
  <scroll-view class="scroll-area" scroll-y refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" enhanced show-scrollbar="{{false}}">
    <!-- 创建团队 -->
    <view class="panel">
      <view class="panel__title">创建团队</view>
      <view class="panel__row">
        <input class="panel__input" placeholder="输入团队名称" placeholder-class="panel__placeholder"
          value="{{createName}}" bindinput="onCreateInput" maxlength="20" confirm-type="done" />
        <view class="panel__btn panel__btn--primary {{submitting ? 'panel__btn--disabled' : ''}}" bindtap="onCreate">创建</view>
      </view>
    </view>

    <!-- 加入团队 -->
    <view class="panel">
      <view class="panel__title">加入团队</view>
      <view class="panel__row">
        <input class="panel__input" placeholder="输入 8 位邀请码" placeholder-class="panel__placeholder"
          value="{{joinCode}}" bindinput="onJoinInput" maxlength="8" confirm-type="done" />
        <view class="panel__btn {{submitting ? 'panel__btn--disabled' : ''}}" bindtap="onJoin">加入</view>
      </view>
    </view>

    <!-- 我的团队 -->
    <view class="list-title">我的团队（{{teams.length}}）</view>
    <block wx:if="{{teams.length > 0}}">
      <view class="team-card" wx:for="{{teams}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onTeamTap">
        <view class="team-card__avatar">{{item.icon}}</view>
        <view class="team-card__body">
          <view class="team-card__name">
            <text>{{item.name}}</text>
            <text class="team-card__role">{{item.role_label}}</text>
          </view>
          <view class="team-card__meta">{{item.member_count}} 位成员 · 厨师：{{item.chef || '待认领'}}</view>
          <view class="team-card__meta">邀请码：{{item.invite_code || '—'}}</view>
        </view>
        <text class="team-card__arrow">›</text>
      </view>
    </block>
    <empty-state wx:elif="{{!loading}}" icon="🏠" text="还没有团队，创建或加入一个吧" />
  </scroll-view>
</view>