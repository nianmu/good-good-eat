.list {
  padding: 24rpx;
}

.list-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.list-header__title {
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.list-header__count {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.recipe-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.recipe-card:active {
  opacity: 0.85;
}

.recipe-card__thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}

.recipe-card__body {
  flex: 1;
  min-width: 0;
}

.recipe-card__name {
  font-size: var(--font-size-base);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.recipe-card__desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.recipe-card__meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.recipe-card__pub {
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
}

.recipe-card__arrow {
  color: var(--color-text-placeholder);
  font-size: 36rpx;
}

/* 右下角新建悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
  z-index: 10;
}

.fab:active {
  background: var(--color-primary-dark);
  transform: scale(0.94);
}

.fab__icon {
  font-size: 56rpx;
  line-height: 1;
}
