.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
  color: var(--color-text-placeholder);
  text-align: center;
}

.empty-state__icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-state__text {
  font-size: var(--font-size-sm);
  line-height: 1.6;
}