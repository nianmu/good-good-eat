.dish-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--color-divider);
}

.dish-card:last-child {
  border-bottom: none;
}

.dish-card:active {
  opacity: 0.85;
}

.dish-card__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  flex-shrink: 0;
}

.dish-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-card__name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dish-card__joined {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  border-radius: var(--radius-full);
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.dish-card__desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-card__meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.dish-card__rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--color-accent);
}

.dish-card__rating-count {
  color: var(--color-text-placeholder);
}

.dish-card__cook-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.dish-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-card__price {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--color-danger);
}

.dish-card__price-symbol {
  font-size: var(--font-size-xs);
  font-weight: 400;
}

.dish-card__action {
  display: flex;
  align-items: center;
}

/* 未加购时的独立 + 按钮（对齐原型 qty-btn） */
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.qty-btn--plus {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-primary);
}

.qty-btn--plus:active {
  transform: scale(0.9);
}