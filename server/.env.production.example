# 好好吃饭 · 生产环境变量模板（服务器 .env）
# 部署到服务器后：复制为 /opt/good-good-eat/server/.env 并按实际填写。
# ⚠️ 不要提交真实值到仓库。

DEBUG=false
API_PREFIX=/api/v1

# 生产数据库（阿里云轻量自动带 MySQL8 或你自己装的 MySQL）
DATABASE_URL=mysql+pymysql://goodgoodeat:替换为强密码@127.0.0.1:3306/good_good_eat?charset=utf8mb4
TEST_DATABASE_URL=  # 生产环境留空即可（测试只在本机跑）

# 生产必须改：随机长字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=替换为随机长串
JWT_EXPIRE_DAYS=30

# 微信小程序正式/测试号凭据（联调测试号已提供 appid；发布用正式号 appid+secret）
WX_APPID=
WX_SECRET=

# 允许的小程序后台配置的服务器域名（生产必须写具体域名，不要留 *）
CORS_ORIGINS=api.你的域名.com