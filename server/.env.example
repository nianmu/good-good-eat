# ===== 好好吃饭 · 后端环境变量模板 =====
# 复制为 .env 后按需修改；.env 不入库

DEBUG=true
API_PREFIX=/api/v1

# 本机 MySQL8（端口 3307）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3307/good_good_eat?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3307/good_good_eat_test?charset=utf8mb4

JWT_SECRET=dev-secret-change-me-please-use-a-longer-random-secret-32b-plus
JWT_EXPIRE_DAYS=30

# 微信小程序凭据（appid 已配置；secret 待提供，任一为空时 wx-login 返回 40001 引导游客登录）
WX_APPID=wx6056573ab9ee889b
WX_SECRET=

CORS_ORIGINS=*

# 团队协作购物车存储（Redis；本机开发默认 127.0.0.1:6379 无密码）
REDIS_URL=redis://127.0.0.1:6379/0

# AI 智能推荐（通用 OpenAI 兼容接口；AI_API_KEY 为空则功能禁用）
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
